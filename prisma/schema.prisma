generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  role            Role             @default(OWNER)
  banned          Boolean?
  banReason       String?
  banExpires      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  invoices        Invoice[]
  ownedBusinesses Business[]
  memberships     BusinessMember[]
  preference      UserPreference?
}

model UserPreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  businessId String?
  branchId   String?
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model Business {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  tin       String?
  vatNumber String?
  address   String?
  currency  String   @default("ETB")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User             @relation(fields: [ownerId], references: [id])
  branches Branch[]
  members  BusinessMember[]
  invoices Invoice[]
  products Product[]
  preferences UserPreference[]

  @@index([ownerId])
}

model Branch {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members  BusinessMember[]
  invoices Invoice[]
  preferences UserPreference[]

  @@unique([businessId, name])
  @@index([businessId])
}

model BusinessMember {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  branchId   String?
  role       Role     @default(CASHIER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@index([branchId])
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  CASHIER
}

model Session {
  id             String   @id
  token          String   @unique
  userId         String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime?
}

model EimsToken {
  id           String   @id @default(cuid())
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model Counter {
  id         String @id @default(cuid())
  businessId String
  branchId   String
  name       String
  value      Int    @default(0)

  @@unique([businessId, branchId, name])
}

enum RegistrationStatus {
  PENDING
  PROCESSING
  REGISTERED
  CANCELLED
  FAILED
}

enum ReceiptStatus {
  ISSUED
  FAILED
}

enum EimsOperationType {
  REGISTER
  CANCEL
}

enum EimsOperationStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum EimsOperationItemStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum TransactionType {
  B2B
  B2C
}

model Invoice {
  id         String  @id @default(cuid())
  number     String
  date       String  @db.VarChar(10)
  taxRate    Decimal @db.Decimal(5, 2)
  subtotal   Decimal @db.Decimal(14, 2)
  taxAmount  Decimal @db.Decimal(14, 2)
  grandTotal Decimal @db.Decimal(14, 2)

  transactionType TransactionType @default(B2B)

  buyerLegalName   String?
  buyerTin         String?
  buyerVatNumber   String?
  buyerIdType      String?
  buyerIdNumber    String?
  buyerEmail       String?
  buyerPhone       String?
  buyerCity        String?
  buyerRegion      String?
  buyerCountry     String?
  buyerZone        String?
  buyerKebele      String?
  buyerWereda      String?
  buyerHouseNumber String?

  paymentMode String @default("CASH")
  paymentTerm String @default("IMMIDIATE")

  incomeWithholdRate Decimal? @default(2) @db.Decimal(5, 2)
  cashierName        String   @default("AAA")
  salesPersonName    String   @default("AAA")

  irn                String?             @db.Text
  registrationStatus RegistrationStatus?
  registrationError  Json?
  registeredAt       DateTime?

  receipt Receipt?

  eimsOperationItems EimsOperationItem[]

  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines     InvoiceLine[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([businessId, branchId, number])
  @@index([businessId, branchId, createdAt])
  @@index([businessId])
  @@index([branchId])
}

model InvoiceLine {
  id               String   @id @default(cuid())
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNumber       Int
  description      String
  quantity         Decimal  @db.Decimal(12, 3)
  unitPrice        Decimal  @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(14, 2)
  itemCode         String?
  unit             String   @default("PCS")
  natureOfSupplies String   @default("goods")
  taxCode          String?
  discount         Decimal? @db.Decimal(14, 2)
}

model Receipt {
  id              String         @id @default(cuid())
  invoiceId       String         @unique
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  number          String
  rrn             String?        @db.Text
  qr              String?        @db.LongText
  eimsStatus      String?
  date            DateTime?
  status          ReceiptStatus?
  error           String?        @db.Text
  collectedAmount Decimal?       @db.Decimal(14, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model EimsOperation {
  id             String              @id @default(cuid())
  conversationId String              @unique
  type           EimsOperationType
  status         EimsOperationStatus @default(PROCESSING)
  rawResponse    Json?
  submittedAt    DateTime            @default(now())
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          EimsOperationItem[]
}

model EimsOperationItem {
  id             String                  @id @default(cuid())
  operationId    String
  invoiceId      String
  documentNumber String?
  irn            String?
  status         EimsOperationItemStatus @default(PROCESSING)
  error          Json?
  rawResult      Json?
  operation      EimsOperation           @relation(fields: [operationId], references: [id], onDelete: Cascade)
  invoice        Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([operationId, invoiceId])
  @@index([invoiceId])
}

model SellerProfile {
  id           String   @id @default(cuid())
  businessName String
  street       String
  city         String
  country      String
  legalName    String?
  vatNumber    String?
  email        String?
  phone        String?
  region       String?
  subCity      String?
  wereda       String?
  houseNumber  String?
  locality     String?
  updatedAt    DateTime @updatedAt
}

model Product {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  sellingPrice Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
}
