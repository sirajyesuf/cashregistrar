generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role       @default(user)
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  invoices      Invoice[]
}

enum Role {
  user
  admin
}

model Session {
  id             String    @id
  token          String    @unique
  userId         String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime?
}

model EimsToken {
  id           String    @id @default(cuid())
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime
  updatedAt    DateTime  @updatedAt
}

model Counter {
  id    String @id @default(cuid())
  name  String @unique
  value Int    @default(0)
}

enum RegistrationStatus {
  PENDING
  REGISTERED
  CANCELLED
  FAILED
}

enum ReceiptStatus {
  ISSUED
  FAILED
}

enum TransactionType {
  B2B
  B2C
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  date         String        @db.VarChar(10)
  taxRate      Decimal       @db.Decimal(5, 2)
  subtotal     Decimal       @db.Decimal(14, 2)
  taxAmount    Decimal       @db.Decimal(14, 2)
  grandTotal   Decimal       @db.Decimal(14, 2)

  transactionType TransactionType @default(B2B)

  buyerLegalName  String?
  buyerTin        String?
  buyerVatNumber  String?
  buyerIdType     String?
  buyerIdNumber   String?
  buyerEmail      String?
  buyerPhone      String?
  buyerCity       String?
  buyerRegion     String?
  buyerCountry    String?
  buyerZone       String?
  buyerKebele     String?
  buyerWereda     String?
  buyerHouseNumber String?

  paymentMode String @default("CASH")
  paymentTerm String @default("IMMIDIATE")

  incomeWithholdRate Decimal? @default(2) @db.Decimal(5, 2)
  cashierName        String   @default("AAA")
  salesPersonName    String   @default("AAA")

  irn                String?            @db.Text
  registrationStatus RegistrationStatus?
  registrationError  Json?
  registeredAt       DateTime?

  receipt Receipt?

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines        InvoiceLine[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model InvoiceLine {
  id                String   @id @default(cuid())
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNumber        Int
  description       String
  quantity          Decimal  @db.Decimal(12, 3)
  unitPrice         Decimal  @db.Decimal(12, 2)
  total             Decimal  @db.Decimal(14, 2)
  itemCode          String?
  unit              String   @default("PCS")
  natureOfSupplies  String   @default("goods")
  taxCode           String?
  discount          Decimal? @db.Decimal(14, 2)
}

model Receipt {
  id              String         @id @default(cuid())
  invoiceId       String         @unique
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  number          String
  rrn             String?        @db.Text
  qr              String?        @db.LongText
  eimsStatus      String?
  date            DateTime?
  status          ReceiptStatus?
  error           String?        @db.Text
  collectedAmount Decimal?       @db.Decimal(14, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model SellerProfile {
  id           String   @id @default(cuid())
  businessName String
  street       String
  city         String
  country      String
  legalName    String?
  vatNumber    String?
  email        String?
  phone        String?
  region       String?
  subCity      String?
  wereda       String?
  houseNumber  String?
  locality     String?
  updatedAt    DateTime @updatedAt
}
